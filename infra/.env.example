# Copy to infra/.env and fill in. Never commit the real file.
POSTGRES_USER=tp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tp

# 32+ random characters:   openssl rand -base64 48
JWT_SECRET=
# exactly 32 random bytes, base64:   openssl rand -base64 32
ENCRYPTION_KEY=

# First admin, created when the user table is empty. The account must change this password at first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

API_PORT=3000
CORS_ORIGINS=*
# Shared secret used by userbot/bot to call the API (16+ chars)
SERVICE_TOKEN=

# Userbot (MTProto). Create an app at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Internal bot: the token is NOT set here, an admin sets it via PUT /api/v1/telegram/bot (stored encrypted).
# polling (default) or webhook (needs BOT_WEBHOOK_URL + BOT_WEBHOOK_SECRET, 16+ chars)
BOT_MODE=polling
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Admin panel (Next.js). The panel talks to the API server-side only; the browser never sees the API URL or its tokens.
ADMIN_PORT=3001
# Set to true when the panel is served over HTTPS (marks the session cookies Secure).
COOKIE_SECURE=false
