# Copy to infra/.env and fill in. Never commit the real file.
POSTGRES_USER=tp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tp

# 32+ random characters:   openssl rand -base64 48
JWT_SECRET=
# exactly 32 random bytes, base64:   openssl rand -base64 32
ENCRYPTION_KEY=

# First admin, created when the user table is empty. The account must change this password at first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

API_PORT=3000
CORS_ORIGINS=*
# Fake groups/tickets and fake Telegram adapters (no real Telegram needed)
DEMO_MODE=false
# Shared secret used by userbot/bot to call the API (16+ chars)
SERVICE_TOKEN=

# Userbot (MTProto). Create an app at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# true = in-memory fake Telegram (nothing real is connected)
USERBOT_FAKE=false
