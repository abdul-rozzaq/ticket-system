# Build context: repository root.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @tp/api... --filter @tp/shared...
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @tp/shared build \
 && pnpm --filter @tp/api exec prisma generate \
 && pnpm --filter @tp/api build

FROM node:22-alpine AS run
RUN corepack enable && apk add --no-cache openssl
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo /repo
WORKDIR /repo/apps/api
EXPOSE 3000
# Apply migrations, then start. Migrations are forward-only and idempotent (prisma migrate deploy).
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/main.js"]
