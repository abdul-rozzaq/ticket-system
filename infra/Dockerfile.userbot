# Build context: repository root.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/userbot/package.json apps/userbot/
RUN pnpm install --frozen-lockfile --filter @tp/userbot... --filter @tp/shared...
COPY packages/shared packages/shared
COPY apps/userbot apps/userbot
# deploy = production-only tree (no dev dependencies, no sources, workspace packages copied in)
RUN pnpm --filter @tp/shared build  && pnpm --filter @tp/userbot build  && pnpm --filter @tp/userbot deploy --legacy --prod /out

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /out ./
USER node
# No database. No inbound port: it only talks to the API and to Telegram.
CMD ["node", "dist/main.js"]
