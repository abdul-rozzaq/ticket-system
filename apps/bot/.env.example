# Internal bot (apps/bot). Copy to apps/bot/.env for local runs (`pnpm --filter @tp/bot dev`).
# In Docker these come from infra/.env. The bot TOKEN is not set here: an admin stores it encrypted in the API
# (admin panel -> Telegram -> Ichki bot).

# Where the API runs and the shared secret (must equal SERVICE_TOKEN of the API).
API_URL=http://localhost:3000
SERVICE_TOKEN=

# polling (default, needs no public URL) or webhook (needs the two values below, secret 16+ chars).
BOT_MODE=polling
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=8443

# Only for `pnpm --filter @tp/bot smoke` (contract smoke test against a running API on a FRESH database).
# ADMIN_USER=admin
# ADMIN_PASSWORD=
