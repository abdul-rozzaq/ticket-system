# Userbot (apps/userbot). Copy to apps/userbot/.env for local runs (`pnpm --filter @tp/userbot dev` or `... login`).
# In Docker these come from infra/.env.

# Where the API runs and the shared secret (must equal SERVICE_TOKEN of the API).
API_URL=http://localhost:3000
SERVICE_TOKEN=

# Telegram app credentials from https://my.telegram.org -> API development tools.
# Use a throwaway Telegram account first (ban risk).
TG_API_ID=
TG_API_HASH=
