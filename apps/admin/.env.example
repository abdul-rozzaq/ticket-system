# Admin panel (apps/admin). Copy to apps/admin/.env.local for local runs (`pnpm --filter @tp/admin dev`).
# In Docker these come from infra/.env / docker-compose.yml.

# Server-side URL of the API. The browser never sees it: it only talks to the panel's own origin.
API_URL=http://localhost:3000

# true when the panel is served over HTTPS (marks the session cookies Secure). Leave false on plain HTTP,
# otherwise the browser drops the cookies and nobody can log in.
COOKIE_SECURE=false
