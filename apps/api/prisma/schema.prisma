// TP Ticket System data model. See PLAN.md.
// Notes:
//  - The "one open ticket per client group" rule is a PARTIAL unique index created in the init migration SQL
//    (Prisma cannot express partial indexes): CREATE UNIQUE INDEX ... ON "Ticket"("clientGroupId") WHERE "status" <> 'CLOSED'.
//  - pgvector is used through raw SQL (Unsupported column type).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs" // the API is CommonJS (NestJS)
  previewFeatures = ["postgresqlExtensions"]
}

// The connection URL lives in prisma.config.ts (Prisma 7) and in the driver adapter (common/prisma.service.ts).
datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  STAFF
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING_CLIENT
  CLOSED
}

enum Urgency {
  LOW
  NORMAL
  HIGH
}

enum SystemType {
  AMOCRM
  BITRIX24
  PBX
  OTHER
}

enum AssignmentStrategy {
  MANUAL
  FIXED_OWNER
  ROUND_ROBIN
  LEAST_LOADED
  ON_DUTY
}

enum MessageDirection {
  IN
  OUT
}

enum KbStatus {
  DRAFT
  APPROVED
  REJECTED
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  displayName        String
  passwordHash       String
  role               Role      @default(STAFF)
  isActive           Boolean   @default(true)
  onDuty             Boolean   @default(false)
  /// Staff can toggle /free and /busy in the bot.
  available          Boolean   @default(true)
  workingHours       Json?
  telegramUserId     BigInt?   @unique
  /// SHA-256 of the one-time link code; the plain code is shown once in the admin panel.
  telegramLinkHash   String?
  telegramLinkExpiry DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens RefreshToken[]
  assigned      Ticket[]       @relation("assignee")
  closed        Ticket[]       @relation("closedBy")
  activities    StaffActivity[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  /// All tokens descending from one login share a family; reuse of a rotated token revokes the family.
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  username  String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model SlaPolicy {
  id                   String  @id @default(uuid()) @db.Uuid
  name                 String
  firstResponseMinutes Int     @default(30)
  resolutionMinutes    Int     @default(480)
  isDefault            Boolean @default(false)

  groups ClientGroup[]
}

model ClientGroup {
  id                 String              @id @default(uuid()) @db.Uuid
  /// Canonical peer key from @tp/shared (e.g. "c:1234567890").
  telegramChatId     String              @unique
  title              String
  companyName        String
  systemType         SystemType          @default(OTHER)
  language           String              @default("uz")
  defaultOwnerId     String?             @db.Uuid
  slaPolicyId        String?             @db.Uuid
  assignmentStrategy AssignmentStrategy?
  isActive           Boolean             @default(true)
  /// Discovered by the userbot but not yet confirmed as a customer group by an admin.
  isConfirmed        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  slaPolicy        SlaPolicy?        @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  tickets          Ticket[]
  filteredMessages FilteredMessage[]

  @@index([isActive])
}

model Ticket {
  id                String       @id @default(uuid()) @db.Uuid
  number            Int          @unique @default(autoincrement())
  clientGroupId     String       @db.Uuid
  status            TicketStatus @default(NEW)
  assigneeId        String?      @db.Uuid
  urgency           Urgency      @default(NORMAL)
  category          String       @default("other")
  systemType        SystemType   @default(OTHER)
  summary           String       @default("")
  aiConfidence      Float?
  needsReview       Boolean      @default(false)
  tags              String[]     @default([])
  openedAt          DateTime     @default(now())
  firstResponseAt   DateTime?
  closedAt          DateTime?
  closedById        String?      @db.Uuid
  solutionNote      String?
  slaDeadline       DateTime
  lastActivityAt    DateTime     @default(now())
  previousTicketId  String?      @db.Uuid
  mergedIntoId      String?      @db.Uuid
  createdFromFilteredId String?  @db.Uuid
  /// Internal-group card (chat id + message id) so the bot can edit it.
  cardChatId        String?
  cardMessageId     BigInt?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  clientGroup ClientGroup     @relation(fields: [clientGroupId], references: [id])
  assignee    User?           @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  closedBy    User?           @relation("closedBy", fields: [closedById], references: [id], onDelete: SetNull)
  messages    TicketMessage[]
  events      TicketEvent[]
  reminders   Reminder[]

  @@index([status, assigneeId])
  @@index([clientGroupId, status])
  @@index([openedAt])
  @@index([closedAt])
  @@index([slaDeadline])
}

model TicketMessage {
  id                 String           @id @default(uuid()) @db.Uuid
  ticketId           String           @db.Uuid
  chatId             String
  telegramMessageId  BigInt?
  senderTelegramId   BigInt?
  senderName         String?
  direction          MessageDirection
  text               String
  mediaMeta          Json?
  isInternalNote     Boolean          @default(false)
  /// Heuristic attribution of outgoing messages (extension activity ping), with confidence 0..1.
  answeredById       String?          @db.Uuid
  answeredConfidence Float?
  sentAt             DateTime         @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([chatId, telegramMessageId])
  @@index([ticketId, sentAt])
}

model TicketEvent {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  type      String
  actorId   String?  @db.Uuid
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Funnel {
  id     String        @id @default(uuid()) @db.Uuid
  name   String
  stages FunnelStage[]
}

model FunnelStage {
  id       String  @id @default(uuid()) @db.Uuid
  funnelId String  @db.Uuid
  /// NEW | WAITING | OVERDUE | CLOSED | STAFF
  kind     String
  title    String
  userId   String? @db.Uuid
  position Int
  isActive Boolean @default(true)

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId, position])
}

model Template {
  id         String   @id @default(uuid()) @db.Uuid
  category   String
  title      String
  bodyUz     String
  bodyRu     String?
  keywords   String[] @default([])
  usageCount Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
}

model KbArticle {
  id             String     @id @default(uuid()) @db.Uuid
  status         KbStatus   @default(DRAFT)
  lang           String     @default("uz")
  systemType     SystemType @default(OTHER)
  category       String     @default("other")
  problem        String
  solution       String
  tags           String[]   @default([])
  sourceTicketId String?    @db.Uuid
  createdById    String?    @db.Uuid
  approvedById   String?    @db.Uuid
  /// Quality metric: AI draft inserted and sent as-is vs. edited by the human.
  sentUnchanged  Int        @default(0)
  sentEdited     Int        @default(0)
  useCount       Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  chunks KbChunk[]

  @@index([status])
}

model KbChunk {
  id        String                       @id @default(uuid()) @db.Uuid
  articleId String                       @db.Uuid
  content   String
  embedding Unsupported("vector(1536)")?

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// A generated reply draft (for staff to review and send). Kept to measure "sent unchanged vs edited".
model AiDraft {
  id            String    @id @default(uuid()) @db.Uuid
  clientGroupId String    @db.Uuid
  ticketId      String?   @db.Uuid
  /// Staff member the draft was generated for (who typed .ai / pressed the button), if known.
  userId        String?   @db.Uuid
  /// The customer message the draft answers (Telegram message id), if one was selected.
  sourceMessageId BigInt?
  /// null when nothing relevant was found.
  text          String?
  notFound      Boolean   @default(false)
  /// llm | extractive
  mode          String    @default("extractive")
  /// [{ type: "article" | "template", id, title, score }]
  sources       Json      @default("[]")
  createdAt     DateTime  @default(now())
  /// UNCHANGED | EDITED | DISCARDED, set when we can tell what the human did with it.
  outcome       String?
  resolvedAt    DateTime?

  @@index([clientGroupId, createdAt])
  @@index([createdAt])
}

model AiProvider {
  id         String   @id @default(uuid()) @db.Uuid
  /// ANTHROPIC | OPENAI_COMPATIBLE
  type       String
  name       String
  baseUrl    String?
  /// AES-256-GCM envelope (see CryptoService). Never returned by the API.
  apiKeyEnc  String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AiSettings {
  id                Int      @id @default(1)
  providerId        String?  @db.Uuid
  classifyModel     String   @default("")
  draftModel        String   @default("")
  embeddingModel    String   @default("")
  summaryModel      String   @default("")
  temperature       Float    @default(0.2)
  maxTokens         Int      @default(1024)
  prompts           Json     @default("{}")
  monthlyBudgetUsd  Float    @default(50)
  hardStop          Boolean  @default(true)
  maskPolicy        String   @default("ALWAYS")
  updatedAt         DateTime @updatedAt
}

model AiUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  task         String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  costUsd      Float    @default(0)
  ok           Boolean  @default(true)
  error        String?
  ticketId     String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([task, createdAt])
}

model FilteredMessage {
  id                String   @id @default(uuid()) @db.Uuid
  clientGroupId     String   @db.Uuid
  telegramMessageId BigInt?
  senderName        String?
  text              String
  /// RULE_SHORT | RULE_ACK | RULE_STAFF | AI_NOT_REQUEST ...
  reason            String
  aiVerdict         Json?
  createdTicketId   String?  @db.Uuid
  createdAt         DateTime @default(now())

  clientGroup ClientGroup @relation(fields: [clientGroupId], references: [id], onDelete: Cascade)

  @@unique([clientGroupId, telegramMessageId])
  @@index([clientGroupId, createdAt])
  @@index([createdAt])
}

/// Messages waiting for the debounce window to pass before AI classification (one buffer per client group).
model IntakeBuffer {
  id            String   @id @default(uuid()) @db.Uuid
  clientGroupId String   @unique @db.Uuid
  chatId        String
  /// [{ messageId: string|null, senderId: string|null, senderName: string|null, text: string, at: ISO }]
  items         Json     @default("[]")
  urgent        Boolean  @default(false)
  firstAt       DateTime @default(now())
  lastAt        DateTime @default(now())

  @@index([lastAt])
}

/// Outbox of commands for the userbot process (it long-polls this through the API; it has no DB access).
model UserbotCommand {
  id        String    @id @default(uuid()) @db.Uuid
  /// LOGIN_SEND_CODE | LOGIN_SUBMIT_CODE | LOGIN_SUBMIT_PASSWORD | LOGOUT | DELETE_MESSAGES | DISCOVER_DIALOGS
  type      String
  payload   Json      @default("{}")
  /// PENDING | CLAIMED | DONE | FAILED
  status    String    @default("PENDING")
  result    Json?
  createdAt DateTime  @default(now())
  claimedAt DateTime?
  doneAt    DateTime?

  @@index([status, createdAt])
}

model TelegramFolderState {
  id               String   @id @default(uuid()) @db.Uuid
  /// Stable key of the funnel stage this folder mirrors, e.g. "NEW", "WAITING", "OVERDUE", "USER:<uuid>".
  key              String   @unique
  telegramFilterId Int
  title            String
  chatCount        Int      @default(0)
  updatedAt        DateTime @updatedAt
}

/// Per-operation log of Telegram folder syncs (create / update / delete / skipped chat), shown in the admin panel.
model FolderOperation {
  id        String   @id @default(uuid()) @db.Uuid
  /// Groups the operations of one reconcile run.
  runId     String   @db.Uuid
  trigger   String
  op        String
  key       String
  ok        Boolean
  detail    Json     @default("{}")
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([runId])
}

model UserbotSession {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String?
  /// AES-256-GCM envelope of the GramJS StringSession.
  sessionEnc     String?
  status         String    @default("LOGGED_OUT")
  lastActivityAt DateTime?
  info           Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Reminder {
  id       String    @id @default(uuid()) @db.Uuid
  ticketId String?   @db.Uuid
  userId   String?   @db.Uuid
  /// UNASSIGNED | ASSIGNED_STALE | WAITING | OVERDUE | DIGEST | SNOOZE
  kind     String
  /// Dedupe key: the same reminder is never created twice (e.g. "UNASSIGNED:<ticketId>:2", "DIGEST:<userId>:2026-11-10").
  key      String?   @unique
  dueAt    DateTime
  sentAt   DateTime?
  payload  Json      @default("{}")

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dueAt, sentAt])
}

model StaffActivity {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @db.Uuid
  chatId String
  ts     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId, ts])
}

/// Messages the internal bot must send/edit in Telegram. The bot process long-polls this through the API.
model BotOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  /// SEND_CARD | EDIT_CARD | SEND_TEXT
  kind      String
  payload   Json
  /// PENDING | CLAIMED | DONE | FAILED
  status    String    @default("PENDING")
  result    Json?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  claimedAt DateTime?
  doneAt    DateTime?

  @@index([status, createdAt])
}
