# API (apps/api). Copy to apps/api/.env for local runs (`pnpm --filter @tp/api dev`).
# In Docker the same variables come from infra/.env through docker-compose.yml.

NODE_ENV=development
PORT=3000

# PostgreSQL with the pgvector extension (e.g. the pgvector/pgvector:pg17 image).
DATABASE_URL=postgresql://tp:tp@localhost:5432/tp?schema=public
REDIS_URL=redis://localhost:6379

# Signs access tokens. 32+ random characters:   openssl rand -base64 48
JWT_SECRET=
# Encrypts secrets at rest (userbot session, AI keys). Exactly 32 random bytes, base64:   openssl rand -base64 32
# Losing it makes stored secrets unreadable: back it up.
ENCRYPTION_KEY=

# Shared secret for the userbot and bot -> API calls (16+ chars). Must equal SERVICE_TOKEN of those apps.
SERVICE_TOKEN=

# First admin, created only when the user table is empty. It can log in right away (no forced password change).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Token lifetimes and login lockout (defaults shown).
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_MINUTES=15

# Browsers allowed to call the API: * or a comma-separated list of origins.
CORS_ORIGINS=*

# Background timers in milliseconds (0 disables). Defaults shown.
INTAKE_POLL_MS=5000
BOT_POLL_MS=30000
FOLDERS_POLL_MS=300000
