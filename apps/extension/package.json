{
  "name": "@tp/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts && vite build -c vite.background.config.ts",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "harness": "node harness/server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "preact": "^11.2.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tp/shared": "workspace:*",
    "@types/chrome": "^0.3.7",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
